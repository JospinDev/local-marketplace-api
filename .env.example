# ----------------------------------------------------- reservations (module 8)
# Duree de validite d'une reservation, en heures. Le compte a rebours repart
# a l'acceptation du vendeur. Passe ce delai, la quantite mise de cote est
# liberee automatiquement (manage.py expirer_reservations).
RESERVATION_DUREE_HEURES=72

# ------------------------------------------------------ evaluations (module 11)
# Duree pendant laquelle l'auteur peut encore corriger son avis. Passe ce
# delai l'avis est definitif : une reputation ne doit pas pouvoir etre
# reecrite des mois plus tard, par exemple sous la pression du vendeur.
EVALUATION_DELAI_MODIFICATION_HEURES=48

# ---------------------------------------------------- notifications (module 12)
# Seuil de l'alerte "produit presque epuise", en unites restantes.
# Modifiable a chaud depuis /api/v1/admin/settings/ (module 14).
STOCK_SEUIL_ALERTE=3

# Notifications push : COMPLEMENTAIRES. Laissez vide pour desactiver :
# les notifications internes et le temps reel fonctionnent sans elles.
#
# ATTENTION : l'ancienne « cle serveur » FCM a ete DESACTIVEE par Google
# en 2024. Tout tutoriel qui demande une FCM_SERVER_KEY est obsolete.
# L'API actuelle (HTTP v1) s'authentifie avec un COMPTE DE SERVICE :
#   1. console.firebase.google.com, creer le projet ;
#   2. Parametres du projet > Comptes de service > Generer une nouvelle
#      cle privee : un fichier JSON se telecharge ;
#   3. le placer HORS du depot et indiquer son chemin ci-dessous ;
#   4. pip install firebase-admin
#
# Ce fichier donne un acces complet a l'envoi de notifications : il se
# traite comme un mot de passe.
FIREBASE_CREDENTIALS_PATH=
