# ------------------------------------------------ front web d'administration
# Prepare pour la console d'administration a venir (dossier admin-web/).
node_modules/
admin-web/node_modules/
admin-web/dist/
admin-web/build/
admin-web/.next/
admin-web/.nuxt/
admin-web/.cache/
admin-web/coverage/
